---
import Base from '../layouts/Base.astro';
import Resources from '../components/Resources.astro';
import Reviews from '../components/Reviews.astro';
import press from '../data/press.json';
import home from '../data/home.json';

import HomeHero from '../components/islands/HomeHero.astro';
import HomeBand from '../components/islands/HomeBand.astro';
import HomeHow from '../components/islands/HomeHow.astro';
import HomePackages from '../components/islands/HomePackages.astro';
import HomeContact from '../components/islands/HomeContact.astro';
import HomeReviews from '../components/islands/HomeReviews.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

const isPreview = process.env.TINA_PREVIEW === 'true';

let frontData = home;
let reviewsData: any = undefined;

if (isPreview) {
  try {
    const { getHome, getReviews } = await import('../lib/tina/data');
    const [homeRes, reviewsRes] = await Promise.allSettled([getHome(), getReviews()]);
    if (homeRes.status === 'fulfilled' && (homeRes.value as any)?.data?.front) {
      frontData = (homeRes.value as any).data.front;
    }
    if (reviewsRes.status === 'fulfilled' && (reviewsRes.value as any)?.data?.reviews) {
      reviewsData = (reviewsRes.value as any).data.reviews;
    }
  } catch (e) {
    console.warn('[@tinacms/astro] Failed to load preview data, using fallback', e);
  }
}
---

<Base
  title="College Admissions Consulting & Essay Coaching | Evergreen Consulting"
  ogTitle="Evergreen Consulting | Harvard-Trained College Admissions Consulting"
  description="Andrea Schiralli, Harvard M.Ed. and Cornell B.A., has coached 20,000+ college essays since 2014. Students admitted to Harvard, Yale, Princeton, Stanford, MIT, Oxford and 900 more schools. New Canaan, CT and worldwide."
>
  {isPreview ? (
    <TinaIsland name="hero" wrapper={{ tag: 'section', className: 'hero' }} primary>
      <HomeHero front={frontData} />
    </TinaIsland>
  ) : (
    <section class="hero">
      <HomeHero front={frontData} />
    </section>
  )}

  <section class="press">
    <div class="wrap press__inner">
      <p class="small muted">Featured by</p>
      <ul class="press__list">
        {[...press, ...press].map(([name, file], i) => (
          <li aria-hidden={i >= press.length ? 'true' : undefined}><img src={`/press/${file}`} alt={i >= press.length ? '' : name} loading="lazy" height="40" /></li>
        ))}
      </ul>
    </div>
  </section>

  {isPreview ? (
    <TinaIsland name="home-band" wrapper={{ tag: 'section', className: 'section section--evergreen band' }}>
      <HomeBand front={frontData} />
    </TinaIsland>
  ) : (
    <section class="section section--evergreen band">
      <HomeBand front={frontData} />
    </section>
  )}

  <Resources />

  {isPreview ? (
    <TinaIsland name="home-how" wrapper={{ tag: 'section', className: 'section' }}>
      <HomeHow front={frontData} />
    </TinaIsland>
  ) : (
    <section class="section">
      <HomeHow front={frontData} />
    </section>
  )}

  {isPreview ? (
    <TinaIsland name="home-reviews" wrapper={{ tag: 'section', className: 'section reviews' }}>
      <HomeReviews reviewsData={reviewsData} />
    </TinaIsland>
  ) : (
    <Reviews />
  )}

  {isPreview ? (
    <TinaIsland name="home-packages" wrapper={{ tag: 'section', className: 'section section--linen' }}>
      <HomePackages front={frontData} />
    </TinaIsland>
  ) : (
    <section class="section section--linen">
      <HomePackages front={frontData} />
    </section>
  )}

  {isPreview ? (
    <TinaIsland name="home-contact" wrapper={{ tag: 'section', className: 'section' }}>
      <HomeContact front={frontData} />
    </TinaIsland>
  ) : (
    <section class="section" id="contact">
      <HomeContact front={frontData} />
    </section>
  )}
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem) 0; }
  .press { padding-block: 1.5rem; }
  .press__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.5rem; }
  .press__inner p { margin: 0; }
  .press__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.25rem; }
  .press__list li { margin: 0; }
  .press__list img { height: 34px; width: auto; }
  .press__list li[aria-hidden] { display: none; }
  @media (max-width: 640px) {
    .press__inner { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
    .press__list { flex-wrap: nowrap; width: max-content; gap: 2.25rem; animation: press 28s linear infinite; }
    .press__list li[aria-hidden] { display: block; }
    .press__list img { height: 26px; }
    .press { overflow: hidden; }
    .press .wrap { width: 100%; }
    .press__inner p { padding-left: var(--gutter); }
    @keyframes press { to { transform: translateX(calc(-50% - 1.125rem)); } }
  }
  @media (prefers-reduced-motion: reduce) { .press__list { animation: none; flex-wrap: wrap; width: auto; } .press__list li[aria-hidden] { display: none; } }
</style>