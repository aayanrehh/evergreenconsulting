---
import Base from '../layouts/Base.astro';
import LogoWall from '../components/LogoWall.astro';
import Resources from '../components/Resources.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';
import data from '../data/services.json';
const services = data.services;
import press from '../data/press.json';
import home from '../data/home.json';

const packages = services.filter((s) => s.tag);
const also = services.filter((s) => !s.tag && s.id !== 'b2b');

const {
  titlePrefix = 'The college application,',
  strikeText = 'survived',
  insertText = 'done well.',
  heroLede = 'Andrea Schiralli coaches students through every essay, the résumé and the interviews, and keeps parents in the loop the whole way. Harvard M.Ed. Cornell B.A. More than 20,000 essays since 2014.',
  primaryCtaText = 'Talk to Andrea',
  primaryCtaHref = '/contact/',
  secondaryCtaText = 'Get the free essay guide',
  secondaryCtaHref = '/resources/',
  heroPhoto = '/andrea.jpg',
  heroPhotoCaption = 'Andrea Schiralli, founder',
  facts = [],
  bandHeading = 'Where students have gone',
  bandLede = 'Acceptances every year since 2015. About 900 schools so far.',
  bandCtaText = 'See acceptances by year',
  bandCtaHref = '/results/',
  howHeading = 'How Andrea works',
  howPhoto = '/andrea-speaking.jpg',
  howPhotoCaption = 'Keynote at an educational consulting conference in China.',
  howLede = 'Admissions officers read thousands of essays written to impress them. They remember the ones written by a person.',
  howParagraphs = [],
  steps = [],
  promises = [],
  howMoreText = 'More about Andrea',
  howMoreHref = '/about/',
  packagesHeading = 'Packages',
  packagesMuted = 'Pick a package by the length of the school list, or go school by school.',
  packagesCtaText = 'All services and how the process works',
  packagesCtaHref = '/services/',
  contactHeading = 'Start with a conversation.',
  contactLede = 'Tell Andrea where your child is applying and where you are in the process. You will hear back within one business day, and it will not be a sales pitch.',
} = home;
---

<Base
  title="College Admissions Consulting & Essay Coaching | Evergreen Consulting"
  ogTitle="Evergreen Consulting | Harvard-Trained College Admissions Consulting"
  description="Andrea Schiralli, Harvard M.Ed. and Cornell B.A., has coached 20,000+ college essays since 2014. Students admitted to Harvard, Yale, Princeton, Stanford, MIT, Oxford and 900 more schools. New Canaan, CT and worldwide."
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <h1 class="hero__title">
          {titlePrefix}
          <span class="edit">
            <s class="edit__strike">{strikeText}</s>
            <span class="edit__insert">{insertText}</span>
          </span>
        </h1>
        <p class="lede">
          {heroLede}
        </p>
        <div class="hero__actions">
          <a class="btn btn--solid" href={primaryCtaHref}>{primaryCtaText}</a>
          <a class="btn" href={secondaryCtaHref}>{secondaryCtaText}</a>
        </div>
      </div>
      <figure class="hero__photo">
        <div class="frame">
        <img src={heroPhoto} alt="Andrea Schiralli" width="1122" height="1402" loading="eager" fetchpriority="high" />
        </div>
        <figcaption>{heroPhotoCaption}</figcaption>
      </figure>
    </div>
    <div class="wrap">
      <div class="facts" aria-label="At a glance">
        {facts.map((f) => (
          <span><strong>{f.number}</strong> {f.label}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="press">
    <div class="wrap press__inner">
      <p class="small muted">Featured by</p>
      <ul class="press__list">
        {[...press, ...press].map(([name, file], i) => (
          <li aria-hidden={i >= press.length ? 'true' : undefined}><img src={`/press/${file}`} alt={i >= press.length ? '' : name} loading="lazy" height="40" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--evergreen band">
    <div class="wrap">
      <div class="section__head">
        <h2 data-reveal>{bandHeading}</h2>
        <p class="lede lede--dark">{bandLede}</p>
      </div>
    </div>
    <LogoWall />
    <div class="wrap">
      <p class="band-foot"><a class="btn btn--paper" href={bandCtaHref}>{bandCtaText}</a></p>
    </div>
  </section>

  <Resources />

  <section class="section">
    <div class="wrap cols">
      <div class="how__aside">
        <h2 data-reveal>{howHeading}</h2>
        <figure class="photo photo--aside">
          <img src={howPhoto} alt="Andrea Schiralli speaking at an educational consulting conference" width="1254" height="1254" loading="lazy" />
          <figcaption>{howPhotoCaption}</figcaption>
        </figure>
      </div>
      <div>
        <p class="lede">{howLede}</p>
        {howParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
    <div class="wrap">
      <ol class="steps">
        {steps.map((st) => (
          <li><strong>{st.title}</strong><span>{st.description}</span></li>
        ))}
      </ol>
      <div class="promises">
        {promises.map((pr) => (
          <p><strong>{pr.title}</strong> {pr.text}</p>
        ))}
      </div>
      <p><a href={howMoreHref}>{howMoreText}</a></p>
    </div>
  </section>

  <Reviews />

  <section class="section section--linen">
    <div class="wrap">
      <div class="section__head">
        <h2 data-reveal>{packagesHeading}</h2>
        <p class="muted">{packagesMuted}</p>
      </div>
      <div class="cards cards--3">
        {packages.map((s) => (
          <a class="card card--link" href={`/services/#${s.id}`}>
            <span class="card__meta">{s.tag}</span>
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
          </a>
        ))}
      </div>
      <p class="also">
        Also on offer: {also.map((s, i) => (<><a href={`/services/#${s.id}`}>{s.name.toLowerCase()}</a>{i < also.length - 1 ? ', ' : '.'}</>))}
      </p>
      <p><a class="btn" href={packagesCtaHref}>{packagesCtaText}</a></p>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap cols">
      <div>
        <h2 data-reveal>{contactHeading}</h2>
        <p class="lede">{contactLede}</p>
        <dl class="ways">
          <dt>Email</dt><dd><a href="mailto:andrea@evergreenconsulting.co">andrea@evergreenconsulting.co</a></dd>
          <dt>WhatsApp or phone</dt><dd><a href="https://wa.me/12037032710">+1 203-703-2710</a></dd>
          <dt>WeChat</dt><dd><a href="/contact/#wechat">Scan the code on the contact page</a></dd>
        </dl>
      </div>
      <ContactForm compact />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem) 0; }
  .hero__grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 860px) { .hero__grid { grid-template-columns: 7fr 4fr; gap: clamp(2rem, 6vw, 6rem); } }
  .hero__title { max-width: 16ch; margin-bottom: 1.25rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.75rem 0 0; }
  .hero__photo { margin: 0; max-width: 400px; padding-top: 0.35rem; }
  .frame { position: relative; margin-right: 14px; }
  .frame img { position: relative; z-index: 1; border: 1px solid var(--evergreen); padding: 8px; background: var(--paper); }
  .frame::before { content: ''; position: absolute; inset: 0; transform: translate(14px, 14px); background: var(--evergreen); }
  .hero__photo figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: #5a6a62; }
  .hero .facts { margin-top: clamp(2.5rem, 5vw, 4rem); border-bottom: 0; }

  /* The edit: one strike, one insertion, once. */
  .edit { display: inline; margin-left: 0.22em; }
  .edit__strike { position: relative; text-decoration: none; color: var(--sage); white-space: nowrap; }
  .edit__strike::after {
    content: ''; position: absolute; left: -0.03em; right: -0.03em; top: 55%; height: 0.06em;
    background: var(--brass); transform-origin: left; transform: scaleX(0);
    animation: strike 500ms cubic-bezier(.4,0,.2,1) 900ms forwards;
  }
  .edit__insert { position: relative; display: inline-block; color: var(--evergreen); font-family: var(--sans); font-weight: 500; letter-spacing: -0.02em; opacity: 0; animation: insert 600ms ease 1500ms forwards; }
  @keyframes strike { to { transform: scaleX(1); } }
  @keyframes insert { from { opacity: 0; transform: translateY(0.15em); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .edit__strike::after { animation: none; transform: none; }
    .edit__insert { animation: none; opacity: 1; }
  }

  .press { padding-block: 1.5rem; }
  .press__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.5rem; }
  .press__inner p { margin: 0; }
  .press__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.25rem; }
  .press__list li { margin: 0; }
  .press__list img { height: 34px; width: auto; }
  .press__list li[aria-hidden] { display: none; }
  @media (max-width: 640px) {
    .press__inner { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
    .press__list { flex-wrap: nowrap; width: max-content; gap: 2.25rem; animation: press 28s linear infinite; }
    .press__list li[aria-hidden] { display: block; }
    .press__list img { height: 26px; }
    .press { overflow: hidden; }
    .press .wrap { width: 100%; }
    .press__inner p { padding-left: var(--gutter); }
    @keyframes press { to { transform: translateX(calc(-50% - 1.125rem)); } }
  }
  @media (prefers-reduced-motion: reduce) { .press__list { animation: none; flex-wrap: wrap; width: auto; } .press__list li[aria-hidden] { display: none; } }

  .section__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; margin-bottom: 2rem; }
  .section__head h2 { margin: 0; }
  .section__head p { margin: 0; max-width: 46ch; }
  .also { margin: 1.75rem 0 1.5rem; max-width: none; }

  .card--link { text-decoration: none; color: inherit; transition: background-color 160ms ease; }
  .card--link:hover { background: #fff; }
  .card--link h3 { color: var(--evergreen); font-family: var(--serif); font-size: var(--step-2); font-weight: 400; }
  .card--link .card__meta { font-family: var(--sans); font-size: var(--step--1); color: #5a6a62; }
</style>

<style>
  .steps { list-style: none; counter-reset: step; margin: 3rem 0 2.5rem; padding: 0; display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .steps li { counter-increment: step; margin: 0; background: var(--paper); padding: 1.5rem; display: grid; gap: 0.5rem; align-content: start; }
  .steps li::before { content: counter(step); font-family: var(--serif); font-size: var(--step-2); color: var(--brass); line-height: 1; }
  .steps strong { font-weight: 500; color: var(--evergreen); }
  .steps span { font-size: var(--step--1); color: #3a4a42; line-height: 1.5; }
  .promises { display: grid; gap: 1rem 2.5rem; margin-bottom: 1.5rem; }
  @media (min-width: 720px) { .promises { grid-template-columns: 1fr 1fr; } }
  .promises p { margin: 0; font-size: var(--step--1); max-width: 40ch; }
  .promises strong { font-weight: 500; color: var(--evergreen); }
  .band-foot { margin-top: 2.5rem; margin-bottom: 0; }
  .ways { margin: 1.5rem 0 0; }
  .ways dt { font-size: var(--step--1); color: #5a6a62; margin-top: 0.9rem; }
  .ways dd { margin: 0.1rem 0 0; padding: 0; }
  .band .section__head { margin-bottom: 1.5rem; }
</style>
<style>
  .photo--aside { margin-top: 1.5rem; max-width: 380px; }
  .photo--aside img { aspect-ratio: 1; object-fit: cover; }
  @media (min-width: 800px) { .how__aside { position: sticky; top: 6rem; } }
  .photo img { border: 1px solid var(--rule); }
  .photo figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: #5a6a62; }
</style>