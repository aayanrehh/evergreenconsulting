---
import Base from '../layouts/Base.astro';
import data from '../data/resources.json';
import ResourcesContent from '../components/islands/ResourcesContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

const isPreview = process.env.TINA_PREVIEW === 'true';

let resourcesData = data;
if (isPreview) {
  try {
    const { getResources } = await import('../lib/tina/data');
    const res = await getResources();
    if (res?.data?.resources) {
      resourcesData = res.data.resources as any;
    }
  } catch (e) {
    console.warn('[@tinacms/astro] Failed to load preview resources data, using resources.json', e);
  }
}

const { downloads = [] } = resourcesData;

const schema = downloads.map((d: any) => ({
  '@context': 'https://schema.org',
  '@type': 'DigitalDocument',
  name: d.title,
  author: { '@id': `${Astro.site}#andrea` },
  encodingFormat: d.file?.endsWith('.docx')
    ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
    : d.file?.endsWith('.pdf')
    ? 'application/pdf'
    : 'application/octet-stream',
  url: new URL(d.file?.replace(/^\//, '') || '', Astro.site).toString(),
  isAccessibleForFree: true,
  about: d.detail || d.blurb,
}));
---

<Base
  title="Free College Essay Resources: Guide, Workshop Slides, 2026–27 Prompts | Evergreen Admissions Consulting"
  description="Free college application resources from Andrea Schiralli: a full essay-writing guide, her personal statement workshop slides, the 2026–27 Common App prompts explained, brainstorming questions, structure and style tips."
  schema={schema}
>
  {isPreview ? (
    <TinaIsland name="resources" wrapper={{ tag: 'div', className: 'resources-page' }} primary>
      <ResourcesContent data={resourcesData} />
    </TinaIsland>
  ) : (
    <div class="resources-page">
      <ResourcesContent data={resourcesData} />
    </div>
  )}
</Base>
