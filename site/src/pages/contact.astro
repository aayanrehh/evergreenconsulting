---
import Base from '../layouts/Base.astro';
import contact from '../data/contact.json';
import ContactContent from '../components/islands/ContactContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

const isPreview = process.env.TINA_PREVIEW === 'true';

let contactData = contact;
if (isPreview) {
  try {
    const { getContact } = await import('../lib/tina/data');
    const res = await getContact();
    if (res?.data?.contact) {
      contactData = res.data.contact as any;
    }
  } catch (e) {
    console.warn('[@tinacms/astro] Failed to load preview contact data, using contact.json', e);
  }
}
---

<Base
  title="Contact Andrea Schiralli | Evergreen Admissions Consulting"
  description="Contact Andrea Schiralli about college admissions packages, essay editing or B2B partnerships. Email, WhatsApp or WeChat. Replies within one business day."
>
  {isPreview ? (
    <TinaIsland name="contact" wrapper={{ tag: 'div', className: 'contact-page' }} primary>
      <ContactContent contact={contactData} />
    </TinaIsland>
  ) : (
    <div class="contact-page">
      <ContactContent contact={contactData} />
    </div>
  )}
</Base>
