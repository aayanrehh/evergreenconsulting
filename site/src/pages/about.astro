---
import Base from '../layouts/Base.astro';
import about from '../data/about.json';
import AboutContent from '../components/islands/AboutContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

const isPreview = process.env.TINA_PREVIEW === 'true';

let aboutData = about;
if (isPreview) {
  try {
    const { getAbout } = await import('../lib/tina/data');
    const res = await getAbout();
    if (res?.data?.about) {
      aboutData = res.data.about as any;
    }
  } catch (e) {
    console.warn('[@tinacms/astro] Failed to load preview about data, using about.json', e);
  }
}
---

<Base
  title="About Andrea Schiralli, College Admissions Consultant | Evergreen Consulting"
  description="Andrea Schiralli holds an M.Ed. from Harvard and a B.A. from Cornell. A former English teacher, published poet and SAT/GRE author, she has coached college applications since 2014."
>
  {isPreview ? (
    <TinaIsland name="about" wrapper={{ tag: 'div', className: 'about-page' }} primary>
      <AboutContent about={aboutData} />
    </TinaIsland>
  ) : (
    <div class="about-page">
      <AboutContent about={aboutData} />
    </div>
  )}
</Base>
