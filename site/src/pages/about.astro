---
import Base from '../layouts/Base.astro';
import press from '../data/press.json';
import about from '../data/about.json';

const {
  name = 'Andrea Schiralli',
  lede = 'Teacher first, editor second, consultant because families kept asking.',
  portrait = '/andrea.jpg',
  portraitAlt = 'Andrea Schiralli',
  shortVersionHeading = 'The short version',
  shortVersionParagraphs = [],
  educationHeading = 'Education',
  credentials = [],
  experienceHeading = 'Experience',
  experience = [],
  photos = [],
  parentNoteHeading = 'A note to parents',
  parentNoteLede = '',
  parentNoteCtaText = 'Talk with Andrea',
  parentNoteCtaHref = '/contact/',
} = about;
---

<Base
  title="About Andrea Schiralli, College Admissions Consultant | Evergreen Consulting"
  description="Andrea Schiralli holds an M.Ed. from Harvard and a B.A. from Cornell. A former English teacher, published poet and SAT/GRE author, she has coached college applications since 2014."
>
  <section class="section page-head">
    <div class="wrap cols">
      <div>
        <h1>{name}</h1>
        <p class="lede">{lede}</p>
      </div>
      <figure class="portrait">
        <img src={portrait} alt={portraitAlt} width="1000" height="1020" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <h2 data-reveal>{shortVersionHeading}</h2>
      <div>
        {shortVersionParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--linen">
    <div class="wrap cols">
      <h2 data-reveal>{educationHeading}</h2>
      <dl class="creds">
        {credentials.map((c) => (
          <div><dt>{c.school}</dt><dd>{c.detail}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <h2 data-reveal>{experienceHeading}</h2>
      <div>
        <ul class="exp">
          {experience.map((e) => <li>{e}</li>)}
        </ul>
        {photos.length > 0 && (
          <div class="photos">
            {photos.map((ph) => (
              <figure>
                <img src={ph.image} alt={ph.alt} width="1280" height="960" loading="lazy" />
                {ph.caption && <figcaption>{ph.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section section--linen">
    <div class="wrap cols">
      <h2 data-reveal>Featured by</h2>
      <ul class="press">
        {press.map(([name, file]) => (
          <li><img src={`/press/${file}`} alt={name} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--evergreen">
    <div class="wrap cols">
      <h2 data-reveal>{parentNoteHeading}</h2>
      <div>
        <p class="lede lede--dark">
          {parentNoteLede}
        </p>
        <p><a class="btn btn--paper" href={parentNoteCtaHref}>{parentNoteCtaText}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-bottom: 0; }
  .page-head + .section { border-top: 0; }
  .portrait { margin: 0; max-width: 380px; justify-self: end; width: 100%; }
  .portrait img { border: 1px solid var(--rule); padding: 6px; background: #fff; }
  @media (max-width: 799px) { .portrait { justify-self: start; max-width: 280px; } }
  .creds { margin: 0; display: grid; gap: 1.25rem; }
  .creds div { padding-bottom: 1.25rem; border-bottom: 1px solid var(--rule); }
  .creds dt { font-family: var(--serif); font-size: var(--step-1); color: var(--evergreen); }
  .creds dd { margin: 0.2rem 0 0; }
  .exp { padding-left: 1.1em; }
  .exp li { margin-bottom: 0.75em; max-width: 60ch; }
  .photos { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  @media (min-width: 640px) { .photos { grid-template-columns: 1fr 1fr; align-items: start; } }
  .photos figure { margin: 0; }
  .photos img { border: 1px solid var(--rule); aspect-ratio: 4 / 3; object-fit: cover; }
  .photos figcaption { margin-top: 0.5rem; font-size: var(--step--1); color: #5a6a62; }
  .press { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2.5rem; }
  .press li { margin: 0; }
  .press img { height: 44px; width: auto; }
</style>
