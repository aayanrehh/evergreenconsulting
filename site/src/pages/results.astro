---
import Base from '../layouts/Base.astro';
import acceptances from '../data/acceptances.json';
import staticResults from '../data/results.json';
import ResultsHeader from '../components/islands/ResultsHeader.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import LogoWall from '../components/LogoWall.astro';

import { tinaField } from 'tinacms/dist/react';

const isPreview = process.env.TINA_PREVIEW === 'true';
let resultsData: any = null;
if (isPreview) {
  const { getResults } = await import('../lib/tina/data');
  resultsData = await getResults();
}
const results = isPreview && resultsData?.data?.results ? resultsData.data.results : staticResults;

const years = Object.keys(acceptances).sort((a, b) => Number(b) - Number(a));
const order = [
  'Graduate School Acceptances',
  'Top-100 Schools: Undergraduate Acceptances',
  'Undergraduate Acceptances',
  'Additional Undergraduate Acceptances',
  'International Undergraduate Acceptances',
  'Independent School Acceptances',
  'Pre-College Summer Programs',
];
const label = (c: string) => c.replace('Top-100 Schools: Undergraduate Acceptances', 'Top-100 national universities').replace(' Acceptances', '');
---

<Base
  title="Results: College, Graduate & Independent School Acceptances | Evergreen Admissions Consulting"
  description="Acceptances earned by students Andrea Schiralli has coached since 2015: Harvard, Yale, Princeton, Stanford, Columbia, MIT, Oxford, the UCs, and hundreds more, listed by year."
>
  {isPreview ? (
    <TinaIsland name="results-header" wrapper={{ tag: 'div', className: 'results-header-wrap' }} primary>
      <ResultsHeader results={results} />
    </TinaIsland>
  ) : (
    <ResultsHeader results={results} />
  )}

  <section class="section results-body">
    <div class="wrap">
      <div class="logos-wrap">
        <LogoWall />
      </div>
      {years.map((y) => (
        <details class="year">
          <summary><h2>{y}</h2><span class="year__count">{Object.values((acceptances as any)[y]).flat().length} acceptances</span></summary>
          {order.filter((c) => (acceptances as any)[y][c]).map((c) => (
            <div class="group">
              <h3>{label(c)}</h3>
              <ul class="schools">
                {(acceptances as any)[y][c].map((s: string) => <li>{s}</li>)}
              </ul>
            </div>
          ))}
        </details>
      ))}
    </div>
  </section>

  <section class="section section--linen">
    <div class="wrap cols">
      <div>
        <h2 data-tina-field={tinaField(results, 'methodologyHeading') || undefined}>{results.methodologyHeading || 'Honest admissions guidance, zero manufactured guarantees'}</h2>
      </div>
      <div>
        <p data-tina-field={tinaField(results, 'methodologyText') || undefined}>{results.methodologyText}</p>
        <p class="small muted" data-tina-field={tinaField(results, 'localDiscoveryText') || undefined}>
          {results.localDiscoveryText ? (
            results.localDiscoveryText
          ) : (
            <>
              Andrea advises students locally in <a href="/new-canaan-ct/">New Canaan</a>, across <a href="/fairfield-county-ct/">Fairfield County</a>, and nationwide through comprehensive packages and per-school coaching.
            </>
          )}
        </p>
      </div>
    </div>
  </section>

  <section class="section cta-section-wrap">
    <div class="wrap">
      <div class="cta-floating-card">
        <div class="cta-floating-card__content">
          <span class="cta-floating-card__tag">Next Steps</span>
          <h2 data-tina-field={tinaField(results, 'ctaHeading') || undefined}>{results.ctaHeading || 'Start with a conversation'}</h2>
          <p data-tina-field={tinaField(results, 'ctaLede') || undefined}>
            {results.ctaLede || 'Tell Andrea where your child is applying and where you are in the application timeline. Andrea will reply personally.'}
          </p>
        </div>
        <div class="cta-floating-card__actions">
          <a class="btn btn--solid" href={results.ctaPrimaryHref || '/contact/'} data-tina-field={tinaField(results, 'ctaPrimaryText') || undefined}>
            {results.ctaPrimaryText || 'Schedule a consultation'}
          </a>
          <a class="btn" href={results.ctaSecondaryHref || '/services/'} data-tina-field={tinaField(results, 'ctaSecondaryText') || undefined}>
            {results.ctaSecondaryText || 'Explore packages'}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .results-body {
    border-top: none !important;
    padding-top: 2rem;
  }
  .logos-wrap {
    margin-bottom: 2.5rem;
  }
  .year { border-top: 1px solid var(--rule); }
  .year:last-child { border-bottom: 1px solid var(--rule); }
  .year summary { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; cursor: pointer; list-style: none; }
  .year summary::-webkit-details-marker { display: none; }
  .year summary h2 { margin: 0; font-size: var(--step-2); }
  .year__count { font-size: var(--step--1); color: var(--muted); }
  .group { padding-block: 1rem; border-top: 1px dashed var(--rule); }
  .group h3 { font-size: var(--step-0); margin: 0 0 0.5rem; color: var(--evergreen); }
  .schools { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.25rem 1.5rem; font-size: var(--step--1); }

  .cta-section-wrap {
    padding: 4.5rem 0 5rem;
    background: var(--paper);
  }
  .cta-floating-card {
    background: #fff;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--brass);
    border-radius: 6px;
    padding: 3rem clamp(1.5rem, 4vw, 3.5rem);
    box-shadow: 0 8px 24px rgba(31, 74, 60, 0.05);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .cta-floating-card {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 3rem;
    }
  }
  .cta-floating-card__tag {
    display: block;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--brass);
    margin-bottom: 0.5rem;
  }
  .cta-floating-card__content h2 {
    font-size: var(--step-3);
    color: var(--evergreen);
    margin: 0 0 0.5rem;
  }
  .cta-floating-card__content p {
    color: #3a4a42;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
    max-width: 54ch;
  }
  .cta-floating-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>

