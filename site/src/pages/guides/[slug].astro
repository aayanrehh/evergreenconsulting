---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import GuidePostContent from '../../components/islands/GuidePostContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

const isPreview = process.env.TINA_PREVIEW === 'true';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

let { guide } = Astro.props;
const { slug = guide?.id } = Astro.params;

if (!guide && slug) {
  guide = await getEntry('guides', slug);
}

let Content: any = null;
if (guide) {
  try {
    const rendered = await render(guide);
    Content = rendered.Content;
  } catch (err) {
    console.warn('Failed to render guide content', err);
  }
}

let previewGuide: any = null;
if (isPreview && slug) {
  try {
    const { getGuidePost } = await import('../../lib/tina/data');
    const res = await getGuidePost(slug);
    if (res?.data?.guide) {
      previewGuide = res.data.guide;
    }
  } catch (e) {
    console.warn('[@tinacms/astro] Failed to load preview guide post, using static fallback', e);
  }
}

const activeGuide = previewGuide || guide;
const title = activeGuide?.data?.title ?? activeGuide?.title ?? '';
const description = activeGuide?.data?.description ?? activeGuide?.description ?? '';
const metaTitle = activeGuide?.data?.metaTitle || `${title} | Evergreen Admissions Consulting`;
const metaDescription = activeGuide?.data?.metaDescription || description;

const rawDate = activeGuide?.data?.date ?? activeGuide?.date;
const dateObj = rawDate ? new Date(rawDate) : new Date();
const rawUpdated = activeGuide?.data?.updated ?? activeGuide?.updated;
const updatedObj = rawUpdated ? new Date(rawUpdated) : dateObj;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqs = activeGuide?.data?.faqs ?? activeGuide?.faqs ?? [];

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonicalUrl}#article`,
    isPartOf: {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: metaTitle,
      description: metaDescription,
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
    },
    headline: title,
    description: description,
    datePublished: !isNaN(dateObj.getTime()) ? dateObj.toISOString() : new Date().toISOString(),
    dateModified: !isNaN(updatedObj.getTime()) ? updatedObj.toISOString() : (!isNaN(dateObj.getTime()) ? dateObj.toISOString() : new Date().toISOString()),
    author: { '@id': `${Astro.site}#andrea` },
    publisher: { '@id': `${Astro.site}#business` },
    mainEntityOfPage: canonicalUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: Astro.site?.toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides',
        item: new URL('/guides/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: canonicalUrl,
      },
    ],
  },
];

if (faqs && faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqs.map((faq: any) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}
---

<Base title={metaTitle} description={metaDescription} schema={schema}>
  {isPreview ? (
    <TinaIsland
      name="guide-post"
      params={{ id: slug }}
      wrapper={{ tag: 'article', className: 'section post guide-post' }}
      primary
    >
      <GuidePostContent guide={activeGuide} Content={previewGuide ? undefined : Content} />
    </TinaIsland>
  ) : (
    <article class="section post guide-post">
      <GuidePostContent guide={guide} Content={Content} />
    </article>
  )}
</Base>
