---
import Base from '../layouts/Base.astro';
import data from '../data/services.json';
import ServicesContent from '../components/islands/ServicesContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

const isPreview = process.env.TINA_PREVIEW === 'true';

let servicesData = data;
if (isPreview) {
  try {
    const { getServices } = await import('../lib/tina/data');
    const res = await getServices();
    if (res?.data?.services) {
      servicesData = res.data.services as any;
    }
  } catch (e) {
    console.warn('[@tinacms/astro] Failed to load preview services data, using services.json', e);
  }
}

const services = servicesData.services || [];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Evergreen Admissions Consulting services',
    itemListElement: services.map((s: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.name,
        description: s.summary,
        provider: { '@id': `${Astro.site}#business` },
        url: `${Astro.site}services/#${s.id}`,
      },
    })),
  },
];
---

<Base
  title="College Admissions Packages, Essay Editing & B2B Services | Evergreen Admissions Consulting"
  description="College admissions consulting, application strategy, essay coaching, résumé support, and interview preparation for undergraduate and graduate applicants."
  schema={schema}
>
  {isPreview ? (
    <TinaIsland name="services" wrapper={{ tag: 'div', className: 'services-page' }} primary>
      <ServicesContent data={servicesData} />
    </TinaIsland>
  ) : (
    <div class="services-page">
      <ServicesContent data={servicesData} />
    </div>
  )}
</Base>
