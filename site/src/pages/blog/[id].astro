---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import BlogPostContent from '../../components/islands/BlogPostContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';

const isPreview = process.env.TINA_PREVIEW === 'true';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

let { post } = Astro.props;
const { id = post?.id } = Astro.params;
if (!post && id) {
  post = await getEntry('blog', id);
}

let Content: any = null;
if (post) {
  try {
    const rendered = await render(post);
    Content = rendered.Content;
  } catch {}
}

let previewPost: any = null;
if (isPreview && id) {
  try {
    const { getBlogPost } = await import('../../lib/tina/data');
    const res = await getBlogPost(id);
    if (res?.data?.post) {
      previewPost = res.data.post;
    }
  } catch (e) {
    console.warn('[@tinacms/astro] Failed to load preview blog post, using static fallback', e);
  }
}

const activePost = previewPost || post;
const title = activePost?.data?.title ?? activePost?.title ?? '';
const description = activePost?.data?.description ?? activePost?.description ?? '';
const rawDate = activePost?.data?.date ?? activePost?.date;
const dateObj = rawDate ? new Date(rawDate) : new Date();
const image = activePost?.data?.image ?? activePost?.image;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    datePublished: !isNaN(dateObj.getTime()) ? dateObj.toISOString() : new Date().toISOString(),
    author: { '@id': `${Astro.site}#andrea` },
    publisher: { '@id': `${Astro.site}#business` },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    ...(image ? { image: new URL(image, Astro.site).toString() } : {}),
  },
];
---

<Base title={`${title} | Evergreen Admissions Consulting`} description={description} schema={schema}>
  {isPreview ? (
    <TinaIsland
      name="blog-post"
      params={{ id }}
      wrapper={{ tag: 'article', className: 'section post' }}
      primary
    >
      <BlogPostContent post={activePost} Content={previewPost ? undefined : Content} />
    </TinaIsland>
  ) : (
    <article class="section post">
      <BlogPostContent post={post} Content={Content} />
    </article>
  )}
</Base>
