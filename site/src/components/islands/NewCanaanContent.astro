---
import { tinaField } from 'tinacms/dist/react';
import defaultData from '../../data/new-canaan.json';

interface Props {
  data?: any;
}

const { data = defaultData } = Astro.props;

const {
  eyebrow = 'New Canaan, Connecticut',
  heading = 'College Admissions Consultant in New Canaan, CT',
  lede = 'One-on-one college application strategy, essay coaching, and interview preparation by Andrea Schiralli, Harvard M.Ed. and Cornell B.A.',
  primaryCtaText = 'Talk to Andrea',
  primaryCtaHref = '/contact/',
  secondaryCtaText = 'Explore consulting services',
  secondaryCtaHref = '/services/',
  facts = [],
  introHeading = 'Focused guidance for selective college admissions',
  introParagraphs = [],
  pillarsHeading = 'How Evergreen helps New Canaan applicants',
  pillars = [],
  processHeading = 'The Evergreen process',
  processSteps = [],
  aboutHeading = 'About Andrea Schiralli',
  aboutSubtitle = 'Teacher first, editor second, consultant since 2014.',
  aboutParagraphs = [],
  aboutCtaText = 'Read more about Andrea',
  aboutCtaHref = '/about/',
  aboutSecondaryCtaText = 'View student acceptances',
  aboutSecondaryCtaHref = '/results/',
  relatedPagesHeading = 'Explore related resources',
  relatedPages = [],
  faqHeading = 'Frequently asked questions',
  faqSubtitle = 'Clear answers for New Canaan families exploring college admissions consulting.',
  faqs = [],
  ctaHeading = 'Start with a conversation',
  ctaLede = 'Tell Andrea where your child is applying and where you are in the admissions process. Andrea will reply personally.',
  ctaButtonText = 'Get in touch',
  ctaButtonHref = '/contact/',
} = data;
---

<section class="section page-head">
  <div class="wrap">
    <p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow') || undefined}>{eyebrow}</p>
    <h1 data-tina-field={tinaField(data, 'heading') || undefined}>{heading}</h1>
    <p class="lede" data-tina-field={tinaField(data, 'lede') || undefined}>{lede}</p>
    <div class="hero-actions">
      <a class="btn btn--solid" href={primaryCtaHref} data-tina-field={tinaField(data, 'primaryCtaText') || undefined}>{primaryCtaText}</a>
      <a class="btn" href={secondaryCtaHref} data-tina-field={tinaField(data, 'secondaryCtaText') || undefined}>{secondaryCtaText}</a>
    </div>
    {facts.length > 0 && (
      <div class="facts" aria-label="Key facts" data-tina-field={tinaField(data, 'facts') || undefined}>
        {facts.map((f: any, i: number) => (
          <span data-tina-field={tinaField(data, 'facts', i) || undefined}>
            <strong>{f.number}</strong> {f.label}
          </span>
        ))}
      </div>
    )}
  </div>
</section>

<section class="section">
  <div class="wrap cols">
    <div>
      <h2 data-reveal data-tina-field={tinaField(data, 'introHeading') || undefined}>{introHeading}</h2>
    </div>
    <div>
      {introParagraphs.map((p: string, i: number) => (
        <p data-tina-field={tinaField(data, 'introParagraphs', i) || undefined}>{p}</p>
      ))}
    </div>
  </div>
</section>

{pillars.length > 0 && (
  <section class="section section--linen">
    <div class="wrap">
      <div class="section-title-wrap">
        <h2 data-reveal data-tina-field={tinaField(data, 'pillarsHeading') || undefined}>{pillarsHeading}</h2>
      </div>
      <div class="cards cards--2">
        {pillars.map((pillar: any, i: number) => (
          <article class="card" data-tina-field={tinaField(data, 'pillars', i) || undefined}>
            {pillar.tag && <span class="card__meta">{pillar.tag}</span>}
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{processSteps.length > 0 && (
  <section class="section">
    <div class="wrap cols">
      <div>
        <h2 data-reveal data-tina-field={tinaField(data, 'processHeading') || undefined}>{processHeading}</h2>
      </div>
      <div class="process-list">
        {processSteps.map((step: any, i: number) => (
          <div class="process-item" data-tina-field={tinaField(data, 'processSteps', i) || undefined}>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<section class="section section--linen">
  <div class="wrap cols">
    <div>
      <h2 data-reveal data-tina-field={tinaField(data, 'aboutHeading') || undefined}>{aboutHeading}</h2>
      <p class="muted" data-tina-field={tinaField(data, 'aboutSubtitle') || undefined}>{aboutSubtitle}</p>
    </div>
    <div>
      {aboutParagraphs.map((p: string, i: number) => (
        <p data-tina-field={tinaField(data, 'aboutParagraphs', i) || undefined}>{p}</p>
      ))}
      <p>
        <a class="btn" href={aboutCtaHref} data-tina-field={tinaField(data, 'aboutCtaText') || undefined}>{aboutCtaText}</a>
        <a class="btn" style="margin-left: 0.5rem;" href={data.aboutSecondaryCtaHref || aboutSecondaryCtaHref} data-tina-field={tinaField(data, 'aboutSecondaryCtaText') || undefined}>
          {data.aboutSecondaryCtaText || aboutSecondaryCtaText}
        </a>
      </p>
    </div>
  </div>
</section>

{relatedPages && relatedPages.length > 0 && (
  <section class="section">
    <div class="wrap cols">
      <div>
        <h2 data-reveal data-tina-field={tinaField(data, 'relatedPagesHeading') || undefined}>{relatedPagesHeading}</h2>
      </div>
      <div class="related-list">
        {relatedPages.map((page: any, i: number) => (
          <div class="related-item" data-tina-field={tinaField(data, 'relatedPages', i) || undefined}>
            <h3><a href={page.href}>{page.label}</a></h3>
            {page.optionalDescription && <p>{page.optionalDescription}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{faqs.length > 0 && (
  <section class="section section--linen">
    <div class="wrap cols">
      <div>
        <h2 data-reveal data-tina-field={tinaField(data, 'faqHeading') || undefined}>{faqHeading}</h2>
        <p class="muted" data-tina-field={tinaField(data, 'faqSubtitle') || undefined}>{faqSubtitle}</p>
      </div>
      <div class="faqs">
        {faqs.map((faq: any, i: number) => (
          <details class="faq" open={i === 0} data-tina-field={tinaField(data, 'faqs', i) || undefined}>
            <summary><h3>{faq.question}</h3></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<section class="section cta-section-wrap">
  <div class="wrap">
    <div class="cta-floating-card">
      <div class="cta-floating-card__content">
        <span class="cta-floating-card__tag">Admissions Advising in New Canaan</span>
        <h2 data-tina-field={tinaField(data, 'ctaHeading') || undefined}>{ctaHeading}</h2>
        <p data-tina-field={tinaField(data, 'ctaLede') || undefined}>{ctaLede}</p>
      </div>
      <div class="cta-floating-card__actions">
        <a class="btn btn--solid" href={ctaButtonHref} data-tina-field={tinaField(data, 'ctaButtonText') || undefined}>
          {ctaButtonText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .page-head { padding-bottom: 0; }
  .eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .facts { margin-top: 2.5rem; }
  .section-title-wrap { margin-bottom: 2.5rem; }
  .card__meta {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.5rem;
    display: block;
    font-weight: 500;
  }
  .cards--2 {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (min-width: 640px) {
    .cards--2 { grid-template-columns: repeat(2, 1fr); }
  }
  .card {
    background: var(--paper);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .card h3 { font-size: var(--step-0); margin-bottom: 0.5rem; color: var(--evergreen); }
  .card p { font-size: var(--step--1); margin: 0; line-height: 1.55; }
  .process-list, .related-list { display: flex; flex-direction: column; gap: 1.75rem; }
  .process-item, .related-item {
    border-top: 1px dashed var(--rule);
    padding-top: 1.25rem;
  }
  .process-item:first-child, .related-item:first-child { border-top: none; padding-top: 0; }
  .process-item h3, .related-item h3 { font-size: var(--step-0); color: var(--evergreen); margin-bottom: 0.35rem; }
  .process-item p, .related-item p { margin: 0; line-height: 1.55; font-size: var(--step--1); }
  .faqs { display: flex; flex-direction: column; }
  .faq {
    border-top: 1px solid var(--rule);
    padding-block: 1rem;
  }
  .faq:last-child { border-bottom: 1px solid var(--rule); }
  .faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary h3 { font-size: var(--step-0); margin: 0; color: var(--evergreen); }
  .faq p { margin: 0.75rem 0 0; line-height: 1.55; color: #3a4a42; }

  .cta-section-wrap {
    padding: 4.5rem 0 5rem;
    background: var(--paper);
  }
  .cta-floating-card {
    background: #fff;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--brass);
    border-radius: 6px;
    padding: 3rem clamp(1.5rem, 4vw, 3.5rem);
    box-shadow: 0 8px 24px rgba(31, 74, 60, 0.05);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .cta-floating-card {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 3rem;
    }
  }
  .cta-floating-card__tag {
    display: block;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--brass);
    margin-bottom: 0.5rem;
  }
  .cta-floating-card__content h2 {
    font-size: var(--step-3);
    color: var(--evergreen);
    margin: 0 0 0.5rem;
  }
  .cta-floating-card__content p {
    color: #3a4a42;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
    max-width: 54ch;
  }
  .cta-floating-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>

