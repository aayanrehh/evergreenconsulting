---
import LogoWall from '../LogoWall.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  front: any;
}

const { front = {} } = Astro.props;

const {
  bandHeading = 'Where students have gone',
  bandLede = 'Acceptances every year since 2015. About 900 schools so far.',
  bandCtaText = 'See acceptances by year',
  bandCtaHref = '/results/',
} = front;
---

<div class="wrap">
  <div class="section__head">
    <h2 data-reveal data-tina-field={tinaField(front, 'bandHeading') || undefined}>{bandHeading}</h2>
    <p class="lede lede--dark" data-tina-field={tinaField(front, 'bandLede') || undefined}>{bandLede}</p>
  </div>
</div>
<LogoWall />
<div class="wrap">
  <p class="band-foot">
    <a class="btn btn--paper" href={bandCtaHref} data-tina-field={tinaField(front, 'bandCtaText') || undefined}>{bandCtaText}</a>
  </p>
</div>

<style>
  .section__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; margin-bottom: 2rem; }
  .section__head h2 { margin: 0; }
  .section__head p { margin: 0; max-width: 46ch; }
  .band-foot { margin-top: 2.5rem; margin-bottom: 0; }
  :global(.band) .section__head { margin-bottom: 1.5rem; }
</style>
