---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';

interface Props {
  post: any;
  Content?: any;
}

const { post, Content } = Astro.props;

const title = post?.data?.title ?? post?.title ?? '';
const description = post?.data?.description ?? post?.description ?? '';
const rawDate = post?.data?.date ?? post?.date;
const dateObj = rawDate ? new Date(rawDate) : new Date();
const image = post?.data?.image ?? post?.image;
const body = post?.body;

const fmt = (d: Date) => (!isNaN(d.getTime()) ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '');
---

<div class="wrap">
  <p class="small muted">
    <a href="/blog/">Blog</a> · <time datetime={!isNaN(dateObj.getTime()) ? dateObj.toISOString() : undefined} data-tina-field={tinaField(post, 'date') || undefined}>{fmt(dateObj)}</time>
  </p>
  <h1 data-tina-field={tinaField(post, 'title') || undefined}>{title}</h1>
  <p class="lede" data-tina-field={tinaField(post, 'description') || undefined}>{description}</p>
  {image && <img class="post__image" src={image} alt="" loading="eager" data-tina-field={tinaField(post, 'image') || undefined} />}
  <div class="prose" data-tina-field={tinaField(post, 'body') || undefined}>
    {Content ? (
      <Content />
    ) : body ? (
      <TinaMarkdown content={body} />
    ) : null}
  </div>
  <footer class="post__foot">
    <p><strong>Andrea Schiralli</strong> coaches college applications and edits essays. Harvard M.Ed., Cornell B.A., 20,000 essays since 2014.</p>
    <p><a class="btn" href="/contact/">Work with Andrea</a> <a class="btn" href="/resources/">Free resources</a></p>
  </footer>
</div>

<style>
  :global(.post) h1 { font-size: var(--step-3); max-width: 22ch; }
  .post__image { margin: 2rem 0; border: 1px solid var(--rule); }
  .prose { max-width: 68ch; margin-top: 2rem; }
  .prose :global(h2) { font-size: var(--step-2); margin-top: 2em; }
  .prose :global(h3) { margin-top: 1.75em; }
  .prose :global(p), .prose :global(li) { line-height: 1.7; }
  .prose :global(li) { margin-bottom: 0.75em; }
  .prose :global(img) { border: 1px solid var(--rule); margin: 1.5rem 0; }
  .prose :global(blockquote) { margin: 1.5rem 0; padding-left: 1.25rem; border-left: 2px solid var(--brass); color: #3a4a42; }
  .post__foot { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--rule); max-width: 68ch; }
  .post__foot .btn { margin-right: 0.5rem; }
</style>
